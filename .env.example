# .env.example — copy to .env for local dev. Throwaway local Postgres
# credentials (docker-compose.yml), not secrets.
POSTGRES_USER=phoneme_wordle
POSTGRES_PASSWORD=phoneme_wordle_dev
POSTGRES_DB=phoneme_wordle

# Must stay in sync with the POSTGRES_* values above. localhost:5432
# because the app runs on the host, not inside the compose network.
DATABASE_URL="postgresql://phoneme_wordle:phoneme_wordle_dev@localhost:5432/phoneme_wordle?schema=public"
